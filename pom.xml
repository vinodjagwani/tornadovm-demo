<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>demo</groupId>
  <artifactId>tornadovm-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <tornado.version>8.1.0-jdk22plus</tornado.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.beehive-lab</groupId>
      <artifactId>tornado-api</artifactId>
      <version>${tornado.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.beehive-lab</groupId>
      <artifactId>tornado-runtime</artifactId>
      <version>${tornado.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.beehive-lab</groupId>
      <artifactId>tornado-drivers-opencl</artifactId>
      <version>${tornado.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>demo.GpuDemo</mainClass>
          <classpathScope>runtime</classpathScope>
          <executable>java</executable>
          <arguments>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-Dtornado.enabled.backends=opencl</argument>
            <argument>-classpath</argument>
            <classpath/>
            <argument>demo.GpuDemo</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
